FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HOME=/models
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir '.[parser]' && useradd --uid 10001 --create-home parser
USER 10001:10001
CMD ["uvicorn","houndscraper.parser_worker:create_parser_app","--factory","--host","0.0.0.0","--port","8083","--no-access-log"]
