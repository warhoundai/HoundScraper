FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PLAYWRIGHT_BROWSERS_PATH=/opt/browsers
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN apt-get update && apt-get install -y --no-install-recommends libatomic1 && pip install --no-cache-dir '.[browser]' && python -m playwright install --with-deps chromium && rm -rf /var/lib/apt/lists/* && chmod -R a+rX /opt/browsers && useradd --uid 10001 --create-home browser
USER 10001:10001
CMD ["uvicorn","houndscraper.browser_worker:create_browser_app","--factory","--host","0.0.0.0","--port","8082","--no-access-log"]
